# Local-first backend defaults.
# Copy to .env for local development. Do not commit real secrets.

AITEST_ENV=local
AITEST_API_PREFIX=/api/v2
AITEST_DATABASE_URL=sqlite:///./data/aitest.sqlite3
AITEST_BACKUP_DIR=./data/backups
AITEST_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AITEST_LOG_LEVEL=INFO

# Optional OpenAI-compatible /v1 LLM settings. Keep disabled and empty for offline tests.
AITEST_LLM_PROVIDER=
AITEST_LLM_BASE_URL=
AITEST_LLM_API_KEY=
AITEST_LLM_MODEL=

# Long-running integrations stay disabled by default to avoid accidental external calls.
AITEST_ENABLE_REAL_LLM=false
AITEST_ENABLE_REAL_BROWSER_RUNNER=false
AITEST_ENABLE_REAL_JMETER=false
